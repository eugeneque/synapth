# --- Cortex (backend) -------------------------------------------------------
# PostgreSQL connection. Leave empty to run Cortex on the in-memory seed store
# (handy for local UI work — nothing persists between restarts).
DATABASE_URL="postgresql://synapth:synapth@localhost:5432/synapth?schema=public"

# Auth.js secret: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-32-random-bytes"
AUTH_URL="http://localhost:3000"

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: raises GitHub API rate limits for the aggregator (lib/github-parser.ts).
GITHUB_TOKEN=""

# Platform fee taken from every paid execution, in percent.
SYNAPTH_PLATFORM_FEE_PERCENT=15

# --- Axon (client) ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
