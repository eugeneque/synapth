// Synapth · Cortex data schema
// Money columns are integer micro-dollars (see types/economy.ts).

generator client {
  provider = "prisma-client-js"
  // Netlify builds on Ubuntu but runs functions on Amazon Linux (rhel-openssl-3.0.x).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity (Auth.js tables + Synapth extensions)
// ---------------------------------------------------------------------------

/// types/auth.ts: user < moderator (catalogue verification) < admin (everything).
enum UserRole {
  user
  moderator
  admin
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  handle        String?   @unique
  passwordHash  String?
  role          UserRole  @default(user)
  /// Public profile fields edited in /dashboard/settings. `image` (Auth.js) doubles as the
  /// avatar: an OAuth URL or a `data:image/*` URL uploaded from settings, like `coverImage`.
  bio           String?
  organization  String?
  website       String?
  location      String?
  /// One of `OCCUPATIONS` (types/profile.ts); null = not set.
  occupation    String?
  coverImage    String?
  /// Preferred install target (`cursor` | `claude-desktop` | `claude-code` | `curl`); null = per-skill default.
  defaultTarget String?
  /// Account check mark (types/verification.ts): set by an approved request or by an admin by hand.
  verifiedAt    DateTime?
  verifiedById  String?
  /// "request" | "manual"
  verifiedVia   String?
  /// Builds Synapth itself (types/auth.ts): admin-set flag, brings the `platform-developer` badge.
  developer     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  skills       Skill[]
  installs     Install[]
  wallet       Wallet?
  apiKeys      ApiKey[]
  usageAsCaller UsageEvent[] @relation("UsageCaller")
  usageAsCreator UsageEvent[] @relation("UsageCreator")
  impulsesSent     Impulse[]      @relation("ImpulseFrom")
  impulsesReceived Impulse[]      @relation("ImpulseTo")
  followsSent      Follow[]       @relation("FollowFrom")
  followsReceived  Follow[]       @relation("FollowTo")
  posts            Post[]
  postReactions    PostReaction[]
  postImages       PostImage[]
  comments         Comment[]
  watches          SkillWatch[]
  notifications    Notification[] @relation("NotificationUser")
  badges           UserBadge[]
  moderationRequests ModerationRequest[] @relation("ModerationRequester")
  skillsets          Skillset[]         @relation("SkillsetAuthor")
  skillsetFavorites  SkillsetFavorite[]
  skillsetImages     SkillsetImage[]
  verificationRequests VerificationRequest[] @relation("VerificationApplicant")
  emailCode            EmailCode?
  subscription         Subscription?
  payments             Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Keys agents use to call the gateway (`X-Synapth-Key`). Only the hash is stored.
/// types/api-keys.ts: `sk_live_<32>`, scopes, 90-day expiry, a policy that can only tighten the owner's.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  label      String
  keyHash    String    @unique
  prefix     String
  /// ApiKeyScope[]; keys issued before scopes existed keep read + fetch + execute.
  scopes     String[]  @default(["catalog:read", "skills:fetch", "skills:execute"])
  /// Partial<KeyPolicy>
  policy     Json?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  /// Null only for keys issued before expiry existed.
  expiresAt  DateTime?
  revokedAt  DateTime?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  audit AgentAuditLog[]

  @@index([userId])
}

/// `report_outcome` from agents (ТЗ FR-AI-50/51): one per (key or user, skill, day).
/// `weight` is 0 for keys younger than 7 days and for the skill author's own keys.
model AgentReport {
  id         String   @id @default(cuid())
  skillId    String
  userId     String
  keyId      String?
  /// "success" | "partial" | "fail"
  result     String
  tokens     Int?
  durationMs Int?
  comment    String?
  weight     Float    @default(1)
  /// UTC day, for the one-report-per-day rule.
  day        String
  createdAt  DateTime @default(now())

  @@unique([skillId, userId, keyId, day])
  @@index([skillId])
}

/// Every agent call (ТЗ FR-AI-62): key and agent, action, object + version + hash, policy decision, result.
/// Retention depends on the plan (types/billing.ts); rows are append-only.
model AgentAuditLog {
  id            String   @id @default(cuid())
  userId        String?
  keyId         String?
  /// `X-Agent-Name` as sent (journal only, grants nothing).
  agentName     String?
  action        String
  objectType    String?
  objectId      String?
  objectVersion String?
  objectHash    String?
  /// "allow" | "deny"
  decision      String
  /// Policy rule or error code behind a deny.
  rule          String?
  /// "ok" or an error code (policy_denied, budget_exceeded …)
  result        String
  createdAt     DateTime @default(now())

  key ApiKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([keyId, createdAt])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum SkillCategory {
  MCP
  Prompt
  Tool
}

/// types/trust.ts: Quarantine < Sandbox < Community < Verified < Gov.
enum SecurityLevel {
  Quarantine
  Sandbox
  Community
  Verified
  Gov
}

model Skill {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String
  authorId       String
  version        String
  category       SkillCategory
  securityLevel  SecurityLevel @default(Sandbox)
  downloadsCount Int           @default(0)
  githubStars    Int           @default(0)
  /// USD per execution in micro-dollars; 0 = free.
  priceMicros    Int           @default(0)
  manifest       Json
  repoUrl        String?
  tags           String[]      @default([])
  /// "seed" | "manual" | "github"
  origin         String        @default("manual")
  /// GithubSource snapshot (types/skill.ts)
  source         Json?
  readme         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author    User           @relation(fields: [authorId], references: [id])
  versions  SkillVersion[]
  installs  Install[]
  scans     SecurityScan[]
  usage     UsageEvent[]
  stats     SkillStats?
  watchers  SkillWatch[]
  moderationRequests ModerationRequest[]
  skillsetItems      SkillsetItem[]

  @@index([category, securityLevel])
  @@index([createdAt])
  @@index([origin])
}

/// Immutable history: every published manifest is kept for reproducible installs.
model SkillVersion {
  id        String   @id @default(cuid())
  skillId   String
  version   String
  manifest  Json
  changelog String?
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
}

/// Aggregates recomputed by a cron job; used by the Trending / Hidden Gems ranking.
model SkillStats {
  skillId           String   @id
  installVelocity7d Int      @default(0)
  retentionRate     Float    @default(0)
  executions        Int      @default(0)
  rating            Float?
  updatedAt         DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Install {
  id        String   @id @default(cuid())
  skillId   String
  userId    String?
  /// "cursor" | "claude-desktop" | "claude-code" | "api" | "web"
  client    String
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([skillId, createdAt])
}

model SecurityScan {
  id        String        @id @default(cuid())
  skillId   String
  version   String
  level     SecurityLevel
  /// Array of ScanFinding (see lib/sandbox-scanner.ts)
  findings  Json
  scannerVersion String
  /// Moderator/admin who set the level by hand; null for automated scans.
  reviewedBy String?
  createdAt DateTime      @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, createdAt])
}

// ---------------------------------------------------------------------------
// Creator economy · pay-per-task
// ---------------------------------------------------------------------------

enum LedgerEntryType {
  topup
  hold
  release
  charge
  earning
  platform_fee
  refund
  payout
}

enum ExecutionStatus {
  pending
  succeeded
  failed
  refunded
}

model Wallet {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  balanceMicros          BigInt   @default(0)
  lifetimeEarningsMicros BigInt   @default(0)
  currency               String   @default("USD")
  updatedAt              DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]
}

model LedgerEntry {
  id          String          @id @default(cuid())
  walletId    String
  type        LedgerEntryType
  amountMicros BigInt
  executionId String?
  memo        String
  createdAt   DateTime        @default(now())

  wallet    Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  execution UsageEvent? @relation(fields: [executionId], references: [id])

  @@index([walletId, createdAt])
}

/// One paid call through the gateway. Input payloads are never stored — only a hash.
model UsageEvent {
  id                 String          @id @default(cuid())
  skillId            String
  skillVersion       String
  callerId           String
  creatorId          String
  toolName           String?
  status             ExecutionStatus @default(pending)
  priceMicros        Int
  platformFeeMicros  Int
  creatorShareMicros Int
  /// Key that made the call (daily caps are per key); null for sessions.
  apiKeyId           String?
  latencyMs          Int?
  inputTokens        Int?
  outputTokens       Int?
  httpStatus         Int?
  responseBytes      Int?
  inputHash          String
  createdAt          DateTime        @default(now())

  skill   Skill         @relation(fields: [skillId], references: [id])
  caller  User          @relation("UsageCaller", fields: [callerId], references: [id])
  creator User          @relation("UsageCreator", fields: [creatorId], references: [id])
  ledger  LedgerEntry[]

  @@index([skillId, createdAt])
  @@index([callerId, createdAt])
  @@index([creatorId, createdAt])
  @@index([apiKeyId, createdAt])
}

/// Replay protection for paid calls (ТЗ §5.2, step 7): the same `Idempotency-Key`
/// from the same caller within 24 h returns the stored result without a new charge.
model IdempotencyRecord {
  id          String   @id @default(cuid())
  callerId    String
  key         String
  /// SHA-256 of method + path + body: a reused key with a different request is refused.
  requestHash String
  status      Int
  /// Stored JSON response (our own envelope, never the upstream body).
  response    Json
  executionId String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([callerId, key])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Synapth Pro · subscriptions and payments (types/billing.ts)
// ---------------------------------------------------------------------------

/// One live subscription per account; Free is the absence of a row (or a canceled one).
model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  /// PlanId: free | pro | team | business
  plan               String
  /// month | year
  period             String
  seats              Int       @default(1)
  /// active | past_due | grace | canceled
  status             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  /// Downgrade scheduled for the next period.
  pendingPlan        String?
  provider           String
  /// Saved method at the provider (token id), for renewals. Never card data.
  paymentMethodId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Every checkout: subscription purchases, upgrades, renewals and wallet top-ups.
model Payment {
  id                String    @id @default(cuid())
  userId            String
  /// subscription | topup
  kind              String
  plan              String?
  period            String?
  seats             Int?
  /// Minor units of `currency`.
  amount            Int
  currency          String
  /// yookassa | cloudpayments | mock
  provider          String
  /// card | sbp | invoice
  method            String
  /// pending | succeeded | failed | canceled | refunded
  status            String    @default("pending")
  providerPaymentId String?
  confirmationUrl   String?
  description       String
  failureReason     String?
  /// Change details (upgrade, renewal …), provider metadata echoes.
  metadata          Json?
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Social layer · impulses, posts, comments, watches, notifications, badges
// (types/social.ts, types/badges.ts)
// ---------------------------------------------------------------------------

/// Synapth's "like": one impulse per (from, to) pair, withdrawn by deleting the row.
model Impulse {
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  from User @relation("ImpulseFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ImpulseTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId, createdAt])
}

/// Friend request / follow: one row per (from, to). Two rows in both directions = friends.
/// Followers (one-way or mutual) hear about the followed user's new posts.
model Follow {
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  from User @relation("FollowFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FollowTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId, createdAt])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions PostReaction[]
  images    PostImage[]

  @@index([authorId, createdAt])
}

/// A photo of a post's carousel. Uploaded one by one while the post is being written
/// (`postId` null — a draft, pruned after a day), attached in order when it is published.
model PostImage {
  id        String   @id @default(cuid())
  ownerId   String
  postId    String?
  position  Int      @default(0)
  mime      String
  data      String
  bytes     Int
  createdAt DateTime @default(now())

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@index([ownerId, postId])
}

/// Emoji reaction on a post: one row per (post, user, emoji), toggled. A user may leave several
/// different emojis on one post; the allowed set is `POST_REACTIONS` in `types/social.ts`.
model PostReaction {
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, emoji])
  @@index([postId])
}

enum CommentTargetKind {
  post
  skill
}

/// Polymorphic: `targetId` is a Post id or a Skill id depending on `targetKind`.
model Comment {
  id         String            @id @default(cuid())
  authorId   String
  targetKind CommentTargetKind
  targetId   String
  body       String
  createdAt  DateTime          @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([targetKind, targetId, createdAt])
  @@index([authorId])
}

/// "Watched" skills: the user is notified when a new version lands.
model SkillWatch {
  userId    String
  skillId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

/// One of `NOTIFICATION_KINDS`; `subject` is the matching `NotificationSubject` JSON.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  actorId   String?
  subject   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Award rows only; the catalogue is `BADGES` in types/badges.ts.
model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

// ---------------------------------------------------------------------------
// Staff · moderation requests, crawler run log (types/moderation.ts, cortex/crawl-jobs.ts)
// ---------------------------------------------------------------------------

/// A user asks staff to review a catalogue entry; a moderator/admin closes it with a verdict.
model ModerationRequest {
  id          String    @id @default(cuid())
  skillId     String
  requesterId String
  note        String?
  /// "pending" | "approved" | "rejected"
  status      String    @default("pending")
  reviewerId  String?
  verdictNote String?
  /// Security level the entry ended with when the verdict was recorded.
  resultLevel String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requester User  @relation("ModerationRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([skillId, status])
}

/// One crawler run (scheduled or manual) with its counters and the tail of its log.
model CrawlRun {
  id         String    @id @default(cuid())
  /// "schedule" | "manual"
  trigger    String
  /// "running" | "done" | "aborted" | "failed"
  status     String    @default("running")
  actorId    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  discovered Int       @default(0)
  processed  Int       @default(0)
  imported   Int       @default(0)
  rejected   Int       @default(0)
  errors     Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  error      String?
  /// Array of log lines (capped).
  log        Json      @default("[]")

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Skillsets · hand-made bundles installed with one command (types/skillset.ts)
// ---------------------------------------------------------------------------

/// Created and edited on the platform only; `verified` is a staff decision reset by any composition change.
model Skillset {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  summary      String    @default("")
  /// Markdown; images reference /api/v1/skillsets/images/<SkillsetImage.id>.
  description  String    @default("")
  /// `data:image/*;base64` (resized on the client), like profile avatars.
  avatar       String?
  authorId     String
  verified     Boolean   @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author    User               @relation("SkillsetAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  items     SkillsetItem[]
  changes   SkillsetChange[]
  favorites SkillsetFavorite[]

  @@index([authorId])
  @@index([verified, updatedAt])
}

model SkillsetItem {
  skillsetId String
  skillId    String
  position   Int
  addedById  String
  addedAt    DateTime @default(now())

  skillset Skillset @relation(fields: [skillsetId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillsetId, skillId])
  @@index([skillId])
}

/// "История изменений": one row per added/removed entry, metadata edit or verification change.
model SkillsetChange {
  id         String   @id @default(cuid())
  /// Insertion order: a batch written in one call keeps its sequence (timestamps can tie).
  seq        Int      @default(autoincrement())
  skillsetId String
  /// Null for automatic entries (verification reset after a composition change).
  actorId    String?
  /// "created" | "added" | "removed" | "edited" | "verified" | "unverified"
  action     String
  skillId    String?
  /// Snapshot, so the line survives the entry leaving the catalogue.
  skillName  String?
  skillSlug  String?
  fields     String[] @default([])
  auto       Boolean  @default(false)
  createdAt  DateTime @default(now())

  skillset Skillset @relation(fields: [skillsetId], references: [id], onDelete: Cascade)

  @@index([skillsetId, seq])
}

model SkillsetFavorite {
  userId     String
  skillsetId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillset Skillset @relation(fields: [skillsetId], references: [id], onDelete: Cascade)

  @@id([userId, skillsetId])
  @@index([skillsetId])
}

/// Images inserted into skillset descriptions; base64 payload, served by /api/v1/skillsets/images/[id].
model SkillsetImage {
  id        String   @id @default(cuid())
  ownerId   String
  mime      String
  data      String
  bytes     Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Account verification (cortex/verification.ts)
// ---------------------------------------------------------------------------

model VerificationRequest {
  id           String    @id @default(cuid())
  userId       String
  /// E.164, shown in full to admins only.
  phone        String
  /// "pending" | "approved" | "rejected" | "withdrawn"
  status       String    @default("pending")
  /// Current stage: "submitted" | "scan" | "review" | "decision"
  stage        String    @default("submitted")
  /// VerificationEvent[] — the timeline the applicant watches.
  events       Json      @default("[]")
  /// Eligibility snapshot at submission.
  eligibility  Json
  reviewerId   String?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  decidedAt    DateTime?

  user User @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Email confirmation (cortex/email-verification.ts)
// ---------------------------------------------------------------------------

/// The one live sign-up code of an unconfirmed password account. Only the hash is stored.
model EmailCode {
  userId    String   @id
  codeHash  String
  /// Wrong guesses; the code is burned at EMAIL_CODE_MAX_ATTEMPTS.
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
