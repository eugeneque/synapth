// Synapth · Cortex data schema
// Money columns are integer micro-dollars (see types/economy.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity (Auth.js tables + Synapth extensions)
// ---------------------------------------------------------------------------

enum UserRole {
  user
  creator
  admin
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  handle        String?   @unique
  passwordHash  String?
  role          UserRole  @default(user)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  skills       Skill[]
  installs     Install[]
  wallet       Wallet?
  apiKeys      ApiKey[]
  usageAsCaller UsageEvent[] @relation("UsageCaller")
  usageAsCreator UsageEvent[] @relation("UsageCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Keys agents use to call the gateway (`X-Synapth-Key`). Only the hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  label      String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum SkillCategory {
  MCP
  Prompt
  Tool
}

enum SecurityLevel {
  Sandbox
  Community
  Verified
}

model Skill {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String
  authorId       String
  version        String
  category       SkillCategory
  securityLevel  SecurityLevel @default(Sandbox)
  downloadsCount Int           @default(0)
  githubStars    Int           @default(0)
  /// USD per execution in micro-dollars; 0 = free.
  priceMicros    Int           @default(0)
  manifest       Json
  repoUrl        String?
  tags           String[]      @default([])
  /// "seed" | "manual" | "github"
  origin         String        @default("manual")
  /// GithubSource snapshot (types/skill.ts)
  source         Json?
  readme         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author    User           @relation(fields: [authorId], references: [id])
  versions  SkillVersion[]
  installs  Install[]
  scans     SecurityScan[]
  usage     UsageEvent[]
  stats     SkillStats?

  @@index([category, securityLevel])
  @@index([createdAt])
  @@index([origin])
}

/// Immutable history: every published manifest is kept for reproducible installs.
model SkillVersion {
  id        String   @id @default(cuid())
  skillId   String
  version   String
  manifest  Json
  changelog String?
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
}

/// Aggregates recomputed by a cron job; used by the Trending / Hidden Gems ranking.
model SkillStats {
  skillId           String   @id
  installVelocity7d Int      @default(0)
  retentionRate     Float    @default(0)
  executions        Int      @default(0)
  rating            Float?
  updatedAt         DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Install {
  id        String   @id @default(cuid())
  skillId   String
  userId    String?
  /// "cursor" | "claude-desktop" | "claude-code" | "api" | "web"
  client    String
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([skillId, createdAt])
}

model SecurityScan {
  id        String        @id @default(cuid())
  skillId   String
  version   String
  level     SecurityLevel
  /// Array of ScanFinding (see lib/sandbox-scanner.ts)
  findings  Json
  scannerVersion String
  createdAt DateTime      @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, createdAt])
}

// ---------------------------------------------------------------------------
// Creator economy · pay-per-task
// ---------------------------------------------------------------------------

enum LedgerEntryType {
  topup
  charge
  earning
  platform_fee
  refund
  payout
}

enum ExecutionStatus {
  pending
  succeeded
  failed
  refunded
}

model Wallet {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  balanceMicros          BigInt   @default(0)
  lifetimeEarningsMicros BigInt   @default(0)
  currency               String   @default("USD")
  updatedAt              DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]
}

model LedgerEntry {
  id          String          @id @default(cuid())
  walletId    String
  type        LedgerEntryType
  amountMicros BigInt
  executionId String?
  memo        String
  createdAt   DateTime        @default(now())

  wallet    Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  execution UsageEvent? @relation(fields: [executionId], references: [id])

  @@index([walletId, createdAt])
}

/// One paid call through the gateway. Input payloads are never stored — only a hash.
model UsageEvent {
  id                 String          @id @default(cuid())
  skillId            String
  skillVersion       String
  callerId           String
  creatorId          String
  toolName           String?
  status             ExecutionStatus @default(pending)
  priceMicros        Int
  platformFeeMicros  Int
  creatorShareMicros Int
  latencyMs          Int?
  inputTokens        Int?
  outputTokens       Int?
  inputHash          String
  createdAt          DateTime        @default(now())

  skill   Skill         @relation(fields: [skillId], references: [id])
  caller  User          @relation("UsageCaller", fields: [callerId], references: [id])
  creator User          @relation("UsageCreator", fields: [creatorId], references: [id])
  ledger  LedgerEntry[]

  @@index([skillId, createdAt])
  @@index([callerId, createdAt])
  @@index([creatorId, createdAt])
}
