# Docker images are written to .images.env by deploy.sh.
SYNAPTH_DOMAIN=synapth.ru
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cloudflare

PGADMIN_DOMAIN=pga.localhost8081.ru
PGADMIN_DEFAULT_EMAIL=admin@localhost8081.ru
PGADMIN_DEFAULT_PASSWORD=replace-with-an-independent-pgadmin-password
# Generate with htpasswd -nB. This must be a BCrypt ($2y$...) hash.
PGADMIN_BASIC_AUTH_USERS='admin:$2y$05$replace-with-htpasswd-bcrypt-hash'

POSTGRES_DB=synapth
POSTGRES_USER=synapth
# Use URL-safe characters: Compose uses this value to build DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=https://synapth.ru
NEXT_PUBLIC_APP_URL=https://synapth.ru

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GITHUB_TOKEN=

RESEND_API_KEY=
EMAIL_FROM=Synapth <noreply@synapth.ru>
SYNAPTH_EMAIL_VERIFICATION=0
SYNAPTH_PLATFORM_FEE_PERCENT=15
SYNAPTH_CRON_SECRET=replace-with-openssl-rand-hex-32
SYNAPTH_AUTO_CRAWL=1
