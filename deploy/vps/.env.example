# Docker images are written to .images.env by deploy.sh.
SYNAPTH_DOMAIN=synapth.localhost8081.ru
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cloudflare

POSTGRES_DB=synapth
POSTGRES_USER=synapth
# Use URL-safe characters because the same value appears in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://synapth:replace-with-a-long-url-safe-password@db:5432/synapth?schema=public

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=https://synapth.localhost8081.ru
NEXT_PUBLIC_APP_URL=https://synapth.localhost8081.ru

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GITHUB_TOKEN=

RESEND_API_KEY=
EMAIL_FROM=Synapth <noreply@synapth.localhost8081.ru>
SYNAPTH_EMAIL_VERIFICATION=0
SYNAPTH_PLATFORM_FEE_PERCENT=15
SYNAPTH_CRON_SECRET=replace-with-openssl-rand-hex-32
SYNAPTH_AUTO_CRAWL=1
